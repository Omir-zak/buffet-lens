# Скопируй этот файл в .env и вставь свой ключ. .env не коммитится.

# --- Чат: Groq (бесплатный ключ на console.groq.com) ---
# Любой OpenAI-совместимый провайдер подойдёт: меняются только эти три строки.
LLM_API_KEY=gsk_...
LLM_BASE_URL=https://api.groq.com/openai/v1
DEFAULT_CHAT_MODEL=openai/gpt-oss-120b

# --- Эмбеддинги: локальный Ollama (ollama.com) ---
# Перед запуском: ollama pull nomic-embed-text
EMBEDDING_API_KEY=ollama
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text

# --- Postgres (совпадает с docker-compose.yml) ---
DATABASE_URL=postgresql://buffett:buffett@localhost:5433/buffett

# --- Веб-поиск ---
TAVILY_API_KEY=tvly-...

# --- Langfuse: самостоятельно размещаемый (сервис langfuse в docker-compose.yml) ---
# Ключи ниже это ЛОКАЛЬНЫЕ dev-значения, которые compose создаёт при первом запуске. В облаке
# (cloud.langfuse.com) подставь свои ключи и адрес https://cloud.langfuse.com. Пустые ключи или
# значения с "..." выключают трассировку, приложение работает как обычно.
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev
LANGFUSE_HOST=http://localhost:3000

# --- Малая модель для простых шагов (роутер, судья в eval); пусто = та же, что для ответа ---
ROUTER_MODEL=openai/gpt-oss-20b
SIMPLE_STEP_REASONING_EFFORT=low

# --- Ключ API (необязательно). Если задан, все эндпоинты /v1 требуют заголовок x-api-key ---
# Это значение по умолчанию подключаемого фронтенда; для локальной разработки.
API_KEY=zimshire-dev-secret
